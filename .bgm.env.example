# Copy to `.bgm.env` (gitignored) to keep run settings out of your OS shell.
# scripts/bgm.sh and bgm.bat load this file only for the spawned process.
# Format: KEY=value, one per line; lines starting with # are ignored.

# Default cargo profile for the wrapper (release|debug).
BGM_PROFILE=release

# Example values your scenarios can reference via {{ token }} / {{ host }}.
# (Pass them through with -V or read them in your own tooling.)
# BGM_TOKEN=dev-secret
# BGM_HOST=staging.example.com
